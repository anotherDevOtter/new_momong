# 어드민 프론트엔드 환경변수
# 로컬 백엔드 사용: http://localhost:3200/api
# 원격 staging 사용: https://manager-api.merci-momong.com/api
NEXT_PUBLIC_API_URL=http://localhost:3200/api

# (선택) 로컬 개발 전용 — 로그인 화면의 "테스트 계정 로그인" 버튼이 쓸 계정.
# 미설정 시 기본값 사용. NODE_ENV=development 에서만 버튼이 보인다.
