PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=fit_hair

# JWT (운영 환경에서는 반드시 변경)
JWT_SECRET=change_me_in_production

# CORS (허용할 프론트 origin 콤마로 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200

# 공유 링크에 사용할 사용자 프론트 base URL
FRONTEND_URL=http://localhost:3100

# 환경변수 어드민 (선택) - DB admin_accounts 와 별개로 동작
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# 부팅 시 자동 시드되는 기본 어드민 계정 (DB에 어드민이 0명일 때만 동작)
# 미지정 시 admin@momong.com / admin1234 로 생성 — 운영 환경에서는 반드시 변경
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# Swagger UI Basic Auth (생략 시 admin/admin1234)
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin1234
